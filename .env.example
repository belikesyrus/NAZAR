# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-minimum-32-chars
DATABASE_URL=sqlite:///smart_monitoring.db
FLASK_ENV=development
FLASK_DEBUG=1
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# CORS
FRONTEND_URL=http://localhost:5173

# Email (optional for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Production DB (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_monitoring

# CCTV Integration (future)
CCTV_STREAM_BASE_URL=rtsp://your-cctv-server
CCTV_USERNAME=admin
CCTV_PASSWORD=changeme

# Video Conferencing (Jitsi self-hosted or JaaS)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=your-app-id
JITSI_API_KEY=your-api-key

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
